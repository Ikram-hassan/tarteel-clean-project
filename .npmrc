# إعدادات التبعيات الحالية (للمرونة وتقليل حجم node_modules)
auto-install-peers=false
strict-peer-dependencies=false

# الحل الجذري لدعم جميع أنظمة التشغيل والـ Architectures
# هذا يضمن تحميل ملفات الـ Binary لـ LightningCSS و Esbuild وغيرها لويندوز ولينكس وماك
supportedArchitectures.os=[ "win32", "linux", "darwin" ]
supportedArchitectures.cpu=[ "x64", "arm64" ]
